/node_modules
/.next
/out
.vercel
.env
.env.local
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Large audio lives in Vercel Blob, not git (see docs/blob-migration.md).
# Beds, the voice cache, and voice previews are uploaded by the workflows;
# only the manifest (lib/voiceCacheManifest.json) is tracked.
/public/sounds/*.mp3
/public/sounds/**/*.mp3
# The 24 soundscape beds are lossless FLAC now (still Blob-hosted, not in git).
/public/sounds/*.flac
/public/sounds/**/*.flac
/public/voice-cache/*.mp3
/public/voice-previews/*.mp3
# Small tray-audition clips, also Blob-hosted (built by build-sound-previews.sh).
/public/sound-previews/*.mp3
# No audio belongs at the repo root.
/*.mp3
/*.flac

# Capacitor iOS. The ios/ project is generated on a Mac by `npx cap add ios`
# and should be committed EXCEPT the parts below (CocoaPods, build output, and
# the web assets Capacitor copies in on each sync).
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/DerivedData/
*.xcuserstate
xcuserdata/

# Never commit real secrets (.env.local holds API keys + the Blob token).
# Keep the .env.example template tracked as the reference.
.env*
!.env.example
