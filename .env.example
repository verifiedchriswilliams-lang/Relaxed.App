# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — your keys never get committed.

# Anthropic (writes the personalized meditation script)
# Get one at https://console.anthropic.com  → Settings → API Keys
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the script.
# Default is claude-opus-5 (best quality). claude-sonnet-5 is ~half the cost
# with near-identical quality for this kind of writing — swap if cost matters at scale.
# ANTHROPIC_MODEL=claude-opus-5

# ElevenLabs (turns the script into a spoken voice)
# Get one at https://elevenlabs.io  → Profile → API Key
ELEVENLABS_API_KEY=

# Optional: override the two default voices.
# Find voice IDs in the ElevenLabs "Voices" library (the copy-ID button).
# The built-in fallbacks are ElevenLabs' free preset voices "Rachel" and "Adam".
#
# Selected production voices (set these in Vercel's env vars):
#   Her  → Almee  (zA6D7RyKdc2EClouEMkP)
#   Him  → Theo   (UmQN7jS1Ee8B1czsUtQh)
ELEVENLABS_VOICE_FEMALE=zA6D7RyKdc2EClouEMkP
ELEVENLABS_VOICE_MALE=UmQN7jS1Ee8B1czsUtQh

# Optional: fine-tune the meditation voice delivery (both have calm defaults).
# ELEVENLABS_SPEED: speaking rate, 0.7 (slowest) – 1.2 (fastest). Default 1.0 (natural).
# ELEVENLABS_STABILITY: 0 (expressive) – 1 (steady/calm). Default 0.85.
# ELEVENLABS_SPEED=0.8
# ELEVENLABS_STABILITY=0.85
