# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — your keys never get committed.

# Anthropic (writes the personalized meditation script)
# Get one at https://console.anthropic.com  → Settings → API Keys
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the script.
# Default is claude-opus-5 (best quality). claude-sonnet-5 is ~half the cost
# with near-identical quality for this kind of writing — swap if cost matters at scale.
# ANTHROPIC_MODEL=claude-opus-5

# ElevenLabs (turns the script into a spoken voice)
# Get one at https://elevenlabs.io  → Profile → API Key
ELEVENLABS_API_KEY=

# Optional: override the four voices (Her/Him x US/UK).
# The app already ships with these as built-in defaults, so you only need the
# ELEVENLABS_API_KEY above for voice to work. Set any of these to swap a voice.
# Find voice IDs in the ElevenLabs "Voices" library (the copy-ID button).
#
# Production voices baked into the app:
#   Her  US → 7AvtJrjTNyBhBxEvNPIZ      Him  US → 6bPfTtSpgxgD0GeBVfqu
#   Her  UK → Almee (zA6D7RyKdc2EClouEMkP)   Him  UK → Theo (UmQN7jS1Ee8B1czsUtQh)
# ELEVENLABS_VOICE_FEMALE_US=7AvtJrjTNyBhBxEvNPIZ
# ELEVENLABS_VOICE_MALE_US=6bPfTtSpgxgD0GeBVfqu
# ELEVENLABS_VOICE_FEMALE_UK=zA6D7RyKdc2EClouEMkP
# ELEVENLABS_VOICE_MALE_UK=UmQN7jS1Ee8B1czsUtQh

# Optional: fine-tune the meditation voice delivery (both have calm defaults).
# ELEVENLABS_SPEED: speaking rate, 0.7 (slowest) – 1.2 (fastest). Default 1.0 (natural).
# ELEVENLABS_STABILITY: 0 (expressive) – 1 (steady/calm). Default 0.85.
# ELEVENLABS_SPEED=0.8
# ELEVENLABS_STABILITY=0.85

# Pacing + delivery of long sessions.
# SILENCE_SCALE: multiplies every scripted pause so sessions breathe. Default 1.25.
# ELEVENLABS_OUTPUT_FORMAT: audio format returned inline. Default mp3_22050_32
#   (compact; keeps 20-30 min sessions under Vercel's ~4.5MB response cap).
#   A higher-fidelity option like mp3_44100_128 sounds crisper but can make long
#   sessions fail; only raise it if you also move audio out of the JSON payload.
# TTS_CONCURRENCY: how many ElevenLabs calls run at once. Default 4.
# SILENCE_SCALE=1.25
# ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
# TTS_CONCURRENCY=4
